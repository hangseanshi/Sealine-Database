# sealine-api environment variables
# Copy this file to .env and fill in the values.

# ── AI Provider ("openai" or "claude") ───────────────────────────────────────
AI_PROVIDER=openai

# ── Azure OpenAI (used when AI_PROVIDER=openai) ─────────────────────────────
AZURE_OPENAI_ENDPOINT=https://ve-azure-openai.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o-03252025
AZURE_OPENAI_API_VERSION=2024-10-21

# ── Anthropic / Claude (used when AI_PROVIDER=claude) ────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── Model settings ───────────────────────────────────────────────────────────
MAX_TOKENS=8192

# ── Gmail (for send_email tool) ──────────────────────────────────────────────
GMAIL_ADDRESS=you@gmail.com
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
